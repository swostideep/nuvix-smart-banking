# ---------------------------------------------------------------------------
# Copy to .env and adjust. Nothing here is a real secret.
#
# config/settings/prod.py reads DJANGO_SECRET_KEY with no default, so a
# production boot fails loudly rather than silently running on a shared key.
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-me-with-50-random-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Postgres in Docker; omit entirely to fall back to a local SQLite file.
DATABASE_URL=postgres://nuvix:nuvix@localhost:5432/nuvix
DB_CONN_MAX_AGE=600

# Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# Auth
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Credit intelligence.
# "pd-baseline-v1" is the built-in transparent scorecard and needs no ML stack.
# Point this at a version produced by scripts/train_models.py to serve a
# fitted model instead.
ACTIVE_PD_MODEL=pd-baseline-v1

# Communications guardrails
COMMS_MAX_PER_WEEK=4
